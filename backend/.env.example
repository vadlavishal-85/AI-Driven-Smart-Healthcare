# AI Smart Healthcare - Backend Environment Variables
# Copy this file to .env for local development or set in your production hosting environment.

# PostgreSQL Connection (Local development: localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smart_healthcare

# MongoDB Atlas URI (Use your existing MongoDB Atlas cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=ai_smart_healthcare

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_hex_string_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
# For local dev: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# For production (Netlify): add your Netlify site URL (e.g. https://your-site.netlify.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Environment
ENVIRONMENT=development
