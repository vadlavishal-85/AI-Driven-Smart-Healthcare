# Runtime
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins that may call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary database. Set this on Render; it can be a PostgreSQL URL.
# For local development, leave blank to use the default SQLite file, or set a PostgreSQL URL.
DATABASE_URL=

# Choose mysql to opt into a local MySQL database. SQLite is the local default.
APP_DATABASE_BACKEND=sqlite

# Legacy MySQL Configuration (used when APP_DATABASE_BACKEND=mysql and DATABASE_URL is blank)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smarthealthcare
MYSQL_USER=
MYSQL_PASSWORD=

# Optional MongoDB Configuration (no current healthcare API requires it)
MONGODB_URI=
MONGODB_DATABASE=smarthealthcare

# Authentication & Security
SECRET_KEY=
