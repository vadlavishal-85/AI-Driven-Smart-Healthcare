# Runtime
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins that may call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary database. Set this on Render; it can be a PostgreSQL URL.
# Locally you may use a PostgreSQL DATABASE_URL, or leave it blank to use MySQL below.
DATABASE_URL=

# Legacy MySQL Configuration (used only when DATABASE_URL is blank)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smarthealthcare
MYSQL_USER=
MYSQL_PASSWORD=

# Optional MongoDB Configuration (no current healthcare API requires it)
MONGODB_URI=
MONGODB_DATABASE=smarthealthcare

# Authentication & Security
SECRET_KEY=
