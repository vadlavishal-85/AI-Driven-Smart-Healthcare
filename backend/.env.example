# AI Smart Healthcare - Backend Environment Variables
# Copy this file to .env for local development or set these variables in the Render Dashboard.

# PostgreSQL Connection (e.g. Render Managed PostgreSQL or Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smart_healthcare

# MongoDB Atlas URI (Use your existing MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=ai_smart_healthcare

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_hex_string_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://smarthealthcare-frontend.onrender.com

# Environment
ENVIRONMENT=production
