# AI Smart Healthcare - Frontend Environment Variables
# Copy to .env for local development or configure in your deployment settings (e.g. Netlify).

# FastAPI Backend Base URL
# - For local development: leave blank to use the Vite proxy (targeting http://127.0.0.1:8001)
# - For production (Netlify): set to your hosted FastAPI backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=
